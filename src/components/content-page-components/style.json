{
  "collectionName": "components_content_page_components_styles",
  "info": {
    "displayName": "Style",
    "icon": "chartBubble",
    "description": ""
  },
  "options": {},
  "attributes": {
    "Animation": {
      "type": "enumeration",
      "default": "None",
      "enum": [
        "None",
        "Fade",
        "Slide"
      ]
    },
    "BackgroundColor": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "TextColor": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "textAlign": {
      "type": "enumeration",
      "default": "center",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "size": {
      "type": "integer",
      "default": 12,
      "min": 3,
      "max": 12
    },
    "paddingTop": {
      "type": "integer"
    },
    "paddingBottom": {
      "type": "integer"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
