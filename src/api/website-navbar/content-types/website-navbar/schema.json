{
  "kind": "collectionType",
  "collectionName": "website_navbars",
  "info": {
    "singularName": "website-navbar",
    "pluralName": "website-navbars",
    "displayName": "Navbar",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Items": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "navbar-components.image-link",
        "navbar-components.text-link",
        "navbar-components.nav-button",
        "navbar-components.nav-menu"
      ]
    },
    "MobileConfig": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "navbar-components.mobile-config",
      "repeatable": false
    },
    "Style": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Spread Out",
      "enum": [
        "Spaced",
        "Spread Out",
        "Left Aligned",
        "Split"
      ]
    },
    "Appearance": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "solid",
      "enum": [
        "solid",
        "fade in"
      ]
    },
    "FontColor": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "Name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "website": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::website.website",
      "mappedBy": "navbar"
    },
    "siteBanner": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "site-banner-components.site-banner",
      "repeatable": false
    }
  }
}
